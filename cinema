class Snack:
    def __init__(self, name: str, price: float, size: str = "Середній"):
        self.name = name
        self.price = price
        self.size = size

    def get_info(self) -> str:
        return f"Снек: {self.name} ({self.size}) — {self.price:.2f} грн"

class Ticket:
    def __init__(self, movie_title: str, seat_info: str, price: float):
        self.movie_title = movie_title
        self.seat_info = seat_info
        self.price = price

    def apply_discount(self, percent: float):
        self.price -= self.price * (percent / 100)

    def print_ticket(self):
        print(f"- Квиток: {self.movie_title} | Місце: {self.seat_info} | Ціна: {self.price:.2f} грн ---")

