import random


class Review:
    def __init__(self, author: str, rating: int, comment: str):
        self.author = author
        self.rating = max(1, min(5, rating))
        self.comment = comment

    def get_info(self) -> str:
        return f"Оцінка: {self.rating}/5 від {self.author} | '{self.comment}'"

class DiscountVoucher:
    def __init__(self, code: str, discount_percent: float, is_active: bool = True):
        self.code = code
        self.discount_percent = discount_percent
        self.is_active = is_active

    def use(self) -> float:
        if self.is_active:
            self.is_active = False
            return self.discount_percent
        return 0.0

class CinemaHall:
    def __init__(self, name: str, rows: int, seats_per_row: int):
        self.name = name
        self.seats = [Seat(r, s) for r in range(1, rows + 1) for s in range(1, seats_per_row + 1)]

    def get_available_seats_count(self) -> int:
        return sum(1 for seat in self.seats if not seat.is_booked)

    def get_seat(self, row: int, number: int):
        for seat in self.seats:
            if seat.row == row and seat.number == number:
                return seat
        return None


